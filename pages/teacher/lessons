    <script>
        // Document viewing function
        function viewDocument(materialId, fileName, filePath, fileSize) {
            const modal = document.getElementById('documentModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalFileName = document.getElementById('modalFileName');
            const modalFileMeta = document.getElementById('modalFileMeta');
            const modalFileIcon = document.getElementById('modalFileIcon');
            const filePlaceholder = document.getElementById('filePlaceholder');
            const pdfPreview = document.getElementById('pdfPreview');
            const imagePreview = document.getElementById('imagePreview');
            const downloadBtn = document.getElementById('downloadBtn');
            
            // Reset previews
            filePlaceholder.style.display = 'block';
            pdfPreview.style.display = 'none';
            imagePreview.style.display = 'none';
            
            // Set file info
            modalTitle.textContent = '📄 ' + fileName;
            modalFileName.textContent = fileName;
            modalFileMeta.textContent = 'Size: ' + fileSize;
            
            // Set download link
            downloadBtn.href = '../' + filePath;
            
            // Get file extension
            const ext = fileName.split('.').pop().toLowerCase();
            
            // Set icon based on file type
            const icons = {
                'pdf': '📕',
                'doc': '📘',
                'docx': '📘',
                'ppt': '📙',
                'pptx': '📙',
                'xls': '📗',
                'xlsx': '📗',
                'jpg': '🖼️',
                'jpeg': '🖼️',
                'png': '🖼️',
                'gif': '🖼️',
                'txt': '📄',
                'default': '📄'
            };
            modalFileIcon.textContent = icons[ext] || icons['default'];
            
            // Try to preview the file
            const fileUrl = '../' + filePath;
            
            // For images
            if (['jpg', 'jpeg', 'png', 'gif', 'webp', 'bmp'].includes(ext)) {
                filePlaceholder.style.display = 'none';
                imagePreview.style.display = 'block';
                imagePreview.src = fileUrl;
                imagePreview.onerror = function() {
                    imagePreview.style.display = 'none';
                    filePlaceholder.style.display = 'block';
                };
            }
            // For PDFs
            else if (ext === 'pdf') {
                filePlaceholder.style.display = 'none';
                pdfPreview.style.display = 'block';
                pdfPreview.src = fileUrl;
                pdfPreview.onerror = function() {
                    pdfPreview.style.display = 'none';
                    filePlaceholder.style.display = 'block';
                };
            }
            // For text files
            else if (ext === 'txt') {
                filePlaceholder.style.display = 'none';
                // Fetch and display text content
                fetch(fileUrl)
                    .then(response => response.text())
                    .then(text => {
                        const textContainer = document.createElement('pre');
                        textContainer.style.cssText = `
                            width: 100%;
                            max-height: 400px;
                            overflow: auto;
                            background: #f8fafc;
                            padding: 20px;
                            border-radius: 8px;
                            font-family: monospace;
                            font-size: 14px;
                            color: #0f172a;
                            white-space: pre-wrap;
                            word-wrap: break-word;
                        `;
                        textContainer.textContent = text;
                        const container = document.getElementById('filePreviewContainer');
                        container.appendChild(textContainer);
                        // Remove after closing
                        window._textContainer = textContainer;
                    })
                    .catch(() => {
                        filePlaceholder.style.display = 'block';
                    });
            }
            // Word, PowerPoint, Excel files - show info
            else if (['doc', 'docx', 'ppt', 'pptx', 'xls', 'xlsx'].includes(ext)) {
                filePlaceholder.style.display = 'block';
                const placeholderText = document.querySelector('#filePlaceholder p');
                const iconSpan = document.querySelector('#filePlaceholder .big-icon');
                iconSpan.textContent = '📄';
                placeholderText.textContent = 'This is a ' + ext.toUpperCase() + ' file. Click the download button below to open it.';
            }
            
            // Show modal
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        
        function closeModal() {
            const modal = document.getElementById('documentModal');
            modal.classList.remove('active');
            document.body.style.overflow = '';
            
            // Clean up any text container
            if (window._textContainer && window._textContainer.parentNode) {
                window._textContainer.parentNode.removeChild(window._textContainer);
                window._textContainer = null;
            }
            
            // Reset previews
            document.getElementById('pdfPreview').src = '';
            document.getElementById('imagePreview').src = '';
        }
        
        // Close modal when clicking outside
        document.getElementById('documentModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
        
        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });
    </script>
    
